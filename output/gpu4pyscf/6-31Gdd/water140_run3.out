#INFO: **** input file is /g/data/kx58/ep9149/exess/new_exess/gradients/job_scripts/templates/run_gpu4pyscf_gradient_export.py ****
#!/usr/bin/env python3
"""
GPU4PySCF HF gradient benchmark, with optional basis/density export.

RHF + analytic gradient on glycine/water clusters, with per-cycle JK timing
and gradient wall time. With --export, additionally writes out the converged
basis (basis_<name>.json) and density/MO matrices (matricies_<name>.hdf5) in
the format gpu-hf-grad's hf_gradient reads, for inspecting cases where the
benchmark SCF fails to converge. Does not write input.json - only the basis
json + matrices hdf5. --export requires --cart, since the exported basis/
density are only valid for cartesian AOs.

Usage:
    CUDA_VISIBLE_DEVICES=0 python run_gpu4pyscf_gradient_export.py \
        --xyz gly20.xyz --basis cc-pVTZ
    CUDA_VISIBLE_DEVICES=0 python run_gpu4pyscf_gradient_export.py \
        --xyz gly20.xyz --basis cc-pVTZ --cart --export --outdir ./export --name gly20
"""

from __future__ import annotations

import argparse
import json
import time
from pathlib import Path

import numpy as np
import h5py


def read_xyz(path: Path) -> str:
    lines = path.read_text().splitlines()
    nat = int(lines[0].strip())
    body = lines[2 : 2 + nat]
    atoms = []
    for ln in body:
        parts = ln.split()
        atoms.append(f"{parts[0]} {parts[1]} {parts[2]} {parts[3]}")
    return "\n".join(atoms)


def to_numpy(a):
    """Bring a GPU4PySCF/cupy array back to host as a contiguous numpy array."""
    get = getattr(a, "get", None)
    return np.asarray(get() if callable(get) else a)


def double_factorial(n):
    out = 1
    while n > 1:
        out *= n
        n -= 2
    return out


def axial_cart_norm(l, exps):
    """Norm of the axial cartesian primitive x^l exp(-a r^2)."""
    return ((2.0 * exps / np.pi) ** 0.75
            * np.sqrt((4.0 * exps) ** l / double_factorial(2 * l - 1)))


def build_basis_json(mol):
    """Serialise the cartesian basis into the schema read_basis_json expects."""
    atoms = []
    coords_ang = mol.atom_coords(unit="Angstrom")
    for a in range(mol.natm):
        x, y, z = (float(v) for v in coords_ang[a])
        atoms.append({
            "element": mol.atom_pure_symbol(a),
            "x": x,
            "y": y,
            "z": z,
        })

    basis_functions = []
    for i in range(mol.nbas):
        l = int(mol.bas_angular(i))
        atom_id = int(mol.bas_atom(i))
        exps = mol.bas_exp(i)
        ctr = mol.bas_ctr_coeff(i) * axial_cart_norm(l, exps)[:, None]
        nctr = ctr.shape[1]
        for c in range(nctr):
            used = ctr[:, c] != 0.0
            basis_functions.append({
                "angular_momentum": l,
                "atom_id": atom_id,
                "coefficients": [float(v) for v in ctr[used, c]],
                "contraction_degree": int(np.count_nonzero(used)),
                "exponents": [float(v) for v in exps[used]],
            })

    return {
        "atoms": atoms,
        "basis_functions": basis_functions,
        "is_cart": True,
    }


def ao_rescale_factors(mol):
    """Per-AO factor converting PySCF's cartesian AO convention to the
    basis-json one (unit-normalised axial component)."""
    s_diag = mol.intor("int1e_ovlp").diagonal()
    r = np.empty(mol.nao_cart())
    ao = 0
    for i in range(mol.nbas):
        l = int(mol.bas_angular(i))
        ncomp = (l + 1) * (l + 2) // 2
        for _ in range(mol.bas_ctr_coeff(i).shape[1]):
            r[ao:ao + ncomp] = np.sqrt(s_diag[ao])
            ao += ncomp
    assert ao == r.shape[0]
    return r


def pack_lower(mat):
    """Row-major lower triangle (i outer, j = 0..i), matching unpack_lower()."""
    n = mat.shape[0]
    out = np.empty(n * (n + 1) // 2, dtype=np.float64)
    k = 0
    for i in range(n):
        for j in range(i + 1):
            out[k] = mat[i, j]
            k += 1
    return out


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--xyz", required=True, type=Path)
    ap.add_argument("--basis", default="cc-pVTZ")
    ap.add_argument("--cart", action="store_true", help="Use Cartesian (6d/10f) basis functions instead of spherical.")
    ap.add_argument("--max-cycle", type=int, default=15)
    ap.add_argument("--conv-tol", type=float, default=1e-6)
    ap.add_argument("--conv-tol-grad", type=float, default=1e6)
    ap.add_argument("--direct-scf-tol", type=float, default=10 ** -10.5)
    ap.add_argument("--verbose", type=int, default=4)
    ap.add_argument("--export", action="store_true", help="Also export the converged basis/density (requires --cart).")
    ap.add_argument("--outdir", type=Path, default=Path("."), help="Directory to write basis json + matrices hdf5 into (with --export).")
    ap.add_argument("--name", help="Output file prefix, e.g. gly20. Defaults to the xyz stem. (with --export)")
    args = ap.parse_args()

    if args.export and not args.cart:
        raise SystemExit("--cart is required: the exported basis/density are only valid for cartesian AOs.")

    from pyscf import gto
    from gpu4pyscf import scf as gscf
    from gpu4pyscf import grad as ggrad
    import cupy as cp

    t_total = time.perf_counter()

    atom_str = read_xyz(args.xyz)

    mol = gto.M(
        atom=atom_str,
        basis=args.basis,
        unit="Angstrom",
        verbose=args.verbose,
        cart=args.cart,
    )
    nbf = mol.nao_nr()

    mf = gscf.RHF(mol)
    mf.direct_scf = True
    mf.direct_scf_tol = args.direct_scf_tol
    mf.max_cycle = args.max_cycle
    mf.conv_tol = args.conv_tol
    mf.conv_tol_grad = args.conv_tol_grad
    mf.diis_space = 8
    mf.diis_start_cycle = 1

    _orig_get_veff = mf.get_veff

    def timed_get_veff(*a, **kw):
        cp.cuda.Device().synchronize()
        t0 = time.perf_counter()
        result = _orig_get_veff(*a, **kw)
        cp.cuda.Device().synchronize()
        wall = time.perf_counter() - t0
        print(f"    CPU time for vj and vk on gpu {wall:20.2f} sec, wall time {wall:10.2f} sec")
        return result

    mf.get_veff = timed_get_veff

    dm0 = mf.get_init_guess(mol, key="atom")

    print(f"basis = {args.basis}")
    print(f"cart = {args.cart}")
    print(f"number of NR cGTOs = {nbf}")
    print(f"direct_scf_tol = {args.direct_scf_tol}")
    print(f"max_cycle = {args.max_cycle}")
    print(f"conv_tol = {args.conv_tol}")
    print(f"conv_tol_grad = {args.conv_tol_grad}")

    cp.cuda.Device().synchronize()
    t_scf = time.perf_counter()
    e_tot = mf.kernel(dm0=dm0)
    cp.cuda.Device().synchronize()
    t_scf_wall = time.perf_counter() - t_scf
    print(f"\nE HF = {e_tot:.15f}")
    print(f"SCF wall time {t_scf_wall:20.2f} sec, wall time {t_scf_wall:10.2f} sec")

    print("\nComputing HF gradient...")
    cp.cuda.Device().synchronize()
    t_grad = time.perf_counter()
    grad_obj = ggrad.RHF(mf)
    g = grad_obj.kernel()
    cp.cuda.Device().synchronize()
    t_grad_wall = time.perf_counter() - t_grad
    print(f"Gradient wall time {t_grad_wall:20.2f} sec, wall time {t_grad_wall:10.2f} sec")

    t_total_wall = time.perf_counter() - t_total
    print(f"Total processing time {t_total_wall:20.2f} sec, wall time {t_total_wall:10.2f} sec")

    if not args.export:
        return 0

    # ---- export basis json + matrices hdf5 (no input.json) ----------------
    name = args.name or args.xyz.stem
    args.outdir.mkdir(parents=True, exist_ok=True)
    basis_path = args.outdir / f"basis_{name}.json"
    hdf5_path = args.outdir / f"matricies_{name}.hdf5"

    r = ao_rescale_factors(mol)
    dm = to_numpy(mf.make_rdm1()) * np.outer(r, r)       # AO density, [n_ao, n_ao]
    mo_coeff = to_numpy(mf.mo_coeff) * r[:, None]        # [n_ao, n_mo]
    mo_energy = to_numpy(mf.mo_energy)                   # [n_mo]

    with open(basis_path, "w") as f:
        json.dump(build_basis_json(mol), f, indent=2)

    with h5py.File(hdf5_path, "w") as f:
        f.create_dataset("density", data=pack_lower(dm), dtype="f8")
        f.create_dataset("mo_energies", data=mo_energy.astype(np.float64), dtype="f8")
        f.create_dataset("final_coefficients",
                         data=np.ascontiguousarray(mo_coeff.T, dtype=np.float64),
                         dtype="f8")

    print("\nwrote:")
    print(f"  {basis_path}")
    print(f"  {hdf5_path}")

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
